# ==========================================================================
# Variabili d'ambiente del backend Tongue
# Copia questo file in ".env" (per lo sviluppo locale) e compila i valori.
# In produzione (Render) questi valori vanno inseriti nella sezione
# "Environment" del servizio, NON caricati come file.
# ==========================================================================

# Chiave API di OpenAI. Ottienila su https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chiave API di NewsAPI. Ottienila gratis su https://newsapi.org/register
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Opzionale) Modello OpenAI da usare. Default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# (Opzionale) Lingua degli articoli richiesti a NewsAPI. Default: it
# NEWS_LANGUAGE=it

# (Opzionale) Numero massimo di articoli da recuperare. Default: 20
# NEWS_PAGE_SIZE=20

# (Opzionale) Porta del server locale. Default: 3000
# PORT=3000
